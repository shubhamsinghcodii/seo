<?php
// Simple Single-File Website SEO Analyser
// Usage: php -S localhost:8000  then open http://localhost:8000/seo-analyser.php

$report = null;
$error = null;
$inputUrl = '';

function normalize_url($u) {
    $u = trim($u);
    if ($u === '') return '';
    if (!preg_match('#^https?://#i', $u)) $u = 'https://' . $u;
    return $u;
}

function fetch_url($url) {
    $start = microtime(true);
    $html = false; $httpCode = 0; $err = '';
    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_MAXREDIRS => 5,
            CURLOPT_TIMEOUT => 15,
            CURLOPT_USERAGENT => 'Mozilla/5.0 (SEO-Analyser/1.0)',
            CURLOPT_SSL_VERIFYPEER => false,
        ]);
        $html = curl_exec($ch);
        $httpCode = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
        if (curl_errno($ch)) $err = curl_error($ch);
        curl_close($ch);
    } else {
        $ctx = stream_context_create(['http' => ['timeout' => 15, 'header' => "User-Agent: SEO-Analyser/1.0\r\n"]]);
        $html = @file_get_contents($url, false, $ctx);
        if (isset($http_response_header[0]) && preg_match('/\s(\d{3})\s/', $http_response_header[0], $m)) $httpCode = (int)$m[1];
        else $httpCode = $html === false ? 0 : 200;
        if ($html === false) $err = 'Could not fetch URL (allow_url_fopen / network).';
    }
    $time = round(microtime(true) - $start, 2);
    return [$html, $httpCode, $time, $err];
}

function check_len($len, $min, $max) {
    if ($len === 0) return ['FAIL', 'Missing'];
    if ($len >= $min && $len <= $max) return ['PASS', 'Good'];
    return ['WARN', 'Needs improvement'];
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['url'])) {
    $inputUrl = normalize_url($_POST['url']);
    if (!filter_var($inputUrl, FILTER_VALIDATE_URL)) {
        $error = 'Please enter a valid website URL. Example: https://example.com';
    } else {
        list($html, $code, $loadTime, $fetchErr) = fetch_url($inputUrl);
        if ($html === false || $html === '' || $code >= 400 || $code === 0) {
            $error = 'Could not fetch this website. ' . ($fetchErr ?: "HTTP code: $code") . ' Try another URL with https://';
        } else {
            libxml_use_internal_errors(true);
            $dom = new DOMDocument();
            $dom->loadHTML(mb_convert_encoding($html, 'HTML-ENTITIES', 'UTF-8'));
            $xp = new DOMXPath($dom);

            // Title
            $title = trim($xp->query('//title')->length ? $xp->query('//title')->item(0)->textContent : '');
            // Meta description
            $desc = '';
            foreach ($xp->query('//meta[@name="description"]') as $m) $desc = trim($m->getAttribute('content'));
            // Viewport, canonical, robots, favicon, OG
            $hasViewport = $xp->query('//meta[@name="viewport"]')->length > 0;
            $hasCanonical = $xp->query('//link[@rel="canonical"]')->length > 0;
            $hasRobots = $xp->query('//meta[@name="robots"]')->length > 0;
            $hasFavicon = $xp->query('//link[@rel="icon" or @rel="shortcut icon"]')->length > 0;
            $hasOG = $xp->query('//meta[starts-with(@property,"og:")]')->length > 0;

            // Headings
            $h1 = $xp->query('//h1'); $h2 = $xp->query('//h2'); $h3 = $xp->query('//h3');
            $h1List = [];
            foreach ($h1 as $h) $h1List[] = trim(mb_substr($h->textContent, 0, 120));

            // Images
            $imgs = $xp->query('//img');
            $imgTotal = $imgs->length; $imgNoAlt = 0;
            foreach ($imgs as $img) {
                $alt = trim($img->getAttribute('alt'));
                if ($alt === '') $imgNoAlt++;
            }

            // Links
            $host = parse_url($inputUrl, PHP_URL_HOST);
            $in = 0; $ex = 0;
            foreach ($xp->query('//a[@href]') as $a) {
                $href = trim($a->getAttribute('href'));
                if ($href === '' || $href[0] === '#') continue;
                $h = parse_url($href, PHP_URL_HOST);
                if (!$h || $h === $host) $in++; else $ex++;
            }

            // Words
            $bodyText = trim(preg_replace('/\s+/', ' ', $dom->textContent));
            $wordCount = str_word_count($bodyText);
            $isHttps = stripos($inputUrl, 'https://') === 0;
            $sizeKB = round(strlen($html) / 1024, 1);

            // Score (100)
            $score = 0; $checks = [];
            $add = function($label, $status, $detail, $pts) use (&$score, &$checks) {
                if ($status === 'PASS') $score += $pts;
                elseif ($status === 'WARN') $score += (int)($pts / 2);
                $checks[] = ['label' => $label, 'status' => $status, 'detail' => $detail, 'pts' => $pts];
            };

            $t = check_len(mb_strlen($title), 30, 60);
            $add('Title tag', $t[0], ($title ?: 'Missing') . ' (' . mb_strlen($title) . ' chars, ideal 30-60)', 15);
            $d = check_len(mb_strlen($desc), 120, 160);
            $add('Meta description', $d[0], ($desc ? mb_substr($desc,0,160) : 'Missing') . ' (' . mb_strlen($desc) . ' chars, ideal 120-160)', 15);
            $add('Mobile viewport', $hasViewport ? 'PASS' : 'FAIL', $hasViewport ? 'Viewport meta found - mobile friendly' : 'No viewport meta - not mobile friendly', 10);
            $add('H1 heading', $h1->length === 1 ? 'PASS' : ($h1->length === 0 ? 'FAIL' : 'WARN'), "Found {$h1->length} H1 (ideal: exactly 1). H2: {$h2->length}, H3: {$h3->length}", 10);
            $add('Image ALT text', $imgTotal === 0 ? 'WARN' : ($imgNoAlt === 0 ? 'PASS' : 'WARN'), "$imgNoAlt of $imgTotal images missing ALT", 10);
            $add('HTTPS', $isHttps ? 'PASS' : 'FAIL', $isHttps ? 'Secure HTTPS' : 'Not HTTPS', 5);
            $add('Content length', $wordCount >= 300 ? 'PASS' : 'WARN', "$wordCount words (ideal 300+)", 10);
            $add('Internal linking', $in > 0 ? 'PASS' : 'WARN', "Internal: $in, External: $ex", 5);
            $add('Canonical / Social', ($hasCanonical && $hasOG) ? 'PASS' : 'WARN', 'Canonical: ' . ($hasCanonical?'Yes':'No') . ', Open Graph: ' . ($hasOG?'Yes':'No') . ', Favicon: ' . ($hasFavicon?'Yes':'No'), 10);
            $add('Speed + Size', $loadTime < 2 ? 'PASS' : ($loadTime < 4 ? 'WARN' : 'FAIL'), "Loaded in {$loadTime}s, HTML {$sizeKB}KB, HTTP $code", 10);

            $report = compact('title','desc','hasViewport','hasCanonical','hasRobots','hasFavicon','hasOG','h1List','imgTotal','imgNoAlt','in','ex','wordCount','isHttps','sizeKB','code','loadTime','score','checks');
            $report['h2'] = $h2->length; $report['h3'] = $h3->length; $report['h1count'] = $h1->length;
        }
    }
}

function badge($s) {
    $c = $s === 'PASS' ? '#16a34a' : ($s === 'WARN' ? '#d97706' : '#dc2626');
    $bg = $s === 'PASS' ? '#dcfce7' : ($s === 'WARN' ? '#fef3c7' : '#fee2e2');
    return "<span style=\"background:$bg;color:$c;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:700\">$s</span>";
}
